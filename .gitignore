__pycache__/
*.pyc
venv/
venv_wsl/
venv_mac/
venv_win/
*.db
.env
node_modules/
dist/
.vite/
*.tsbuildinfo
data/

# Foundry build artifacts (the workspace SOURCE is tracked; out/cache are not)
backend/dynamic_workspace/out/
backend/dynamic_workspace/cache/

# Large third-party benchmark corpora (cloned by backend/eval/loaders/, not authored here)
datasets/

# Generated eval CHECKPOINTS are large; ignored. The small result tables +
# the committed benchmark snapshot under results/ ARE tracked (see !lines)
# so the deployed dashboard has real numbers without the datasets.
backend/eval/checkpoints/
backend/eval/results/*
!backend/eval/results/baseline_table.md
!backend/eval/results/ablation_ac.md
!backend/eval/results/ablation_ac.json
!backend/eval/results/benchmark_stats.json
# SEM-7 result tables — small, and they are what the dashboard and the paper
# cite. Checkpoints that produced them stay ignored (thousands of files).
!backend/eval/results/benchmark_by_tier*.json
!backend/eval/results/benchmark_by_tier*.md
!backend/eval/results/weighted_aggregation.json
!backend/eval/results/arbitration_sweep.json
!backend/eval/results/arbitration_ablation.json
!backend/eval/results/slither_bench.json

# New benchmark buckets (large, gitignored like datasets/)
smartcontract-datasets/

.vercel

# local scratch
*.log
nohup.out

# Session-scratch orchestration scripts (ad-hoc batch drivers used while runs
# were quota/GPU throttled). The reproducible commands live in RESUME.md and
# the experiments themselves are the tracked eval/*.py modules.
backend/eval/overnight.sh
backend/eval/phaseB.sh
backend/eval/phaseD.sh
backend/eval/finish.sh
backend/eval/pipeline_all.sh
publish_when_done.sh
